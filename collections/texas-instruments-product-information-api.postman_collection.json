          "request": {
            "name": "Get Product Information",
            "description": {
              "content": "Retrieves basic product details and parametric data for a specific TI part number. Part numbers containing /NOPB must be URL-encoded (/ becomes %2F). Daily rate limit: 3,000 calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                ":partNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "partNumber",
                  "description": "(Required) TI part number. URL-encode special characters (e.g., /NOPB becomes %2FNOPB)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
