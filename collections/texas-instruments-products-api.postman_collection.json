          "name": "Get Product Inventory and Pricing",
          "request": {
            "name": "Get Product Inventory and Pricing",
            "description": {
              "content": "Retrieves real-time inventory availability, pricing breaks, future inventory forecasts, and product metadata for a specific TI part number. Part numbers containing /NOPB must be URL-encoded (/ becomes %2F).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                ":partNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "USD",
                  "description": "Currency code for pricing data (e.g., USD, EUR)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "partNumber",
                  "description": "(Required) TI part number (OPN). URL-encode special characters (e.g., /NOPB becomes %2FNOPB)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
