              "name": "Get Product Inventory and Pricing",
              "id": "fe4553e1-ccb2-4c7e-845c-a3e522f4a597",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/products/:partNumber?currency=USD",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "products",
                    ":partNumber"
                  ],
                  "query": [
                    {
                      "description": "Currency code for pricing data (e.g., USD, EUR)",
                      "key": "currency",
                      "value": "USD"
                    }
                  ],
                  "variable": [
                    {
                      "id": "9a0144dc-db9c-482e-adaf-a50c33b8aaf2",
                      "key": "partNumber",
                      "value": "<string>",
                      "description": "(Required) TI part number (OPN). URL-encode special characters (e.g., /NOPB becomes %2FNOPB)."
                    }
                  ]
                },
                "description": "Retrieves real-time inventory availability, pricing breaks, future inventory forecasts, and product metadata for a specific TI part number. Part numbers containing /NOPB must be URL-encoded (/ becomes %2F)."
              },
